DATABASE_URL=your_database_url_here
JWT_SECRET=your_jwt_secret_here
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=API de google
APP_TIMEZONE=America/Bogota

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
OTP_PEPPER=
OTP_SMS_PROVIDER=dev

CORS_ORIGINS=URL-FRONT

# 1 solo si el backend está detrás de un proxy (Render, Railway, nginx...)
TRUST_PROXY=0

# Días que se conservan los documentos de una propiedad rechazada sin reporte abierto
RETENCION_DIAS_RECHAZO=90

# Meses tras los cuales el audit pierde IP y user agent (Ley 1581)
RETENCION_MESES_AUDIT=24

# Wompi (sandbox por defecto; en producción: https://production.wompi.co/v1)
WOMPI_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx
WOMPI_EVENT_SECRET=test_events_xxx
TOTP_ENC_KEY=genera_32_bytes_en_hex_con_openssl_rand_hex_32
