// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum EstadoPropiedad {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoReporte {
  ABIERTO
  RESUELTO
  IGNORADO
}

enum Plan {
  GRATIS
  BASICO
  PREMIUM
}

enum EstadoPago {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Pago {
  id          String     @id @default(uuid())
  usuarioId   String
  usuario     Usuario    @relation(fields: [usuarioId], references: [id])
  monto       Float
  plan        Plan
  comprobante String?
  estado      EstadoPago @default(PENDIENTE)
  createAt    DateTime   @default(now())
  updateAt    DateTime   @updatedAt
}

model Usuario {
  id                  String    @id @default(uuid())
  nombres             String
  apellidos           String
  email               String    @unique
  password            String
  foto                String?
  celular             String?
  celularVerificado   Boolean   @default(false)
  documentoUrl        String?
  documentoVerificado Boolean   @default(false)
  role                Role      @default(USER)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // PlanMonetización
  plan                Plan      @default(GRATIS)
  propiedadesLimite   Int       @default(5)
  chatIaLimite        Int       @default(10)
  chatUsados          Int       @default(0)
  chatFecha           DateTime?
  pagos               Pago[]

  propiedades    Propiedad[]
  reporteFraudes ReporteFraude[]
}

model Propiedad {
  id             String               @id @default(uuid())
  titulo         String
  descripcion    String
  precio         Float
  ciudad         String
  barrio         String
  direccion      String
  estrato        Int
  tipo           String
  habitaciones   Int
  banos          Int
  parqueaderos   Int                  @default(0)
  area           Float
  antiguedad     Int
  fotografias    String[]
  video          String?
  ubicacionLat   Float?
  ubicacionLong  Float?
  puntaje        Int?
  publicadoPorId String //Relacion con Usuario
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  documentos     DocumentoPropiedad[]
  estado         EstadoPropiedad      @default(PENDIENTE)
  motivoRechazo  String?
  destacada      Boolean              @default(false)
  destacadaHasta DateTime?

  //Relación con Usuario
  publicadoPor   Usuario         @relation(fields: [publicadoPorId], references: [id])
  reporteFraudes ReporteFraude[]
}

model DocumentoPropiedad {
  id          String   @id @default(uuid())
  url         String
  tipo        String
  verificado  Boolean  @default(false)
  propiedadId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //Relacion con propiedad
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
}

model ReporteFraude {
  id          String        @id @default(uuid())
  motivo      String
  descripcion String?
  estado      EstadoReporte @default(ABIERTO)
  usuarioId   String
  propiedadId String
  creadoPor   Usuario       @relation(fields: [usuarioId], references: [id])
  propiedad   Propiedad     @relation(fields: [propiedadId], references: [id])
  createAt    DateTime      @default(now())
  updateAt    DateTime      @updatedAt
}
