// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum EstadoPropiedad {
  PENDIENTE
  APROBADA
  RECHAZADA
}

model Usuario {
  id                  String   @id @default(uuid())
  nombres             String
  apellidos           String
  email               String   @unique
  password            String
  foto                String?
  celular             String?
  celularVerificado   Boolean  @default(false)
  documentoUrl        String?
  documentoVerificado Boolean  @default(false)
  role                Role     @default(USER)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  propiedades Propiedad[]
}

model Propiedad {
  id             String               @id @default(uuid())
  titulo         String
  descripcion    String
  precio         Float
  ciudad         String
  barrio         String
  direccion      String
  estrato        Int
  tipo           String
  habitaciones   Int
  banos          Int
  parqueaderos   Int                  @default(0)
  area           Float
  antiguedad     Int
  fotografias    String[]
  video          String?
  ubicacionLat   Float?
  ubicacionLong  Float?
  puntaje        Int?
  publicadoPorId String //Relacion con Usuario
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  documentos     DocumentoPropiedad[]
  estado         EstadoPropiedad      @default(PENDIENTE)
  motivoRechazo  String?

  //Relación con Usuario
  publicadoPor Usuario @relation(fields: [publicadoPorId], references: [id])
}

model DocumentoPropiedad {
  id          String   @id @default(uuid())
  url         String
  tipo        String
  verificado  Boolean  @default(false)
  propiedadId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  //Relacion con propiedad
  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
}
